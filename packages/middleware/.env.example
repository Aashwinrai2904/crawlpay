# Copy to .env (gitignored) and fill in real values for anything you need to
# override. Every variable below has a sensible local-dev default baked into
# the code (see the source files referenced) if you're just running against
# infra/docker-compose.yml or its no-Docker equivalent (see the root
# README's "No working Docker?" section) -- you don't need a .env at all for
# local dev unless you're changing one of these.

# Port the middleware listens on. Default: 8787 (see src/index.ts).
PORT=8787

# Where "allow"-policy traffic gets reverse-proxied to -- the real site this
# middleware sits in front of. Default: http://localhost:4000 (mock-origin,
# see src/server.ts).
ORIGIN_URL=http://localhost:4000

# The x402 facilitator that verifies payment proofs. Default:
# http://localhost:4100 (mock-facilitator, see
# ../core/src/facilitator-client.ts). Point this at a real facilitator in
# production.
CRAWLPAY_FACILITATOR_URL=http://localhost:4100

# Postgres connection string for the transaction log (see
# src/transactions/postgres-transaction-log.ts). Default: the same
# crawlpay/crawlpay/localhost:5432 credentials docker-compose.yml and the
# root README's no-Docker fallback both use.
CRAWLPAY_DATABASE_URL=postgres://crawlpay:crawlpay@localhost:5432/crawlpay

# Redis connection string for response caching (see
# src/cache/redis-cache-store.ts). Default: local Redis on the standard port.
CRAWLPAY_REDIS_URL=redis://localhost:6379

# Shared secret WordPress (Mode B) and any other external caller must
# present via X-Crawlpay-Site-Key to use /stats and /verify-and-price; also
# sent back to WordPress when polling its config endpoint. Generate with
# `openssl rand -hex 32`. Required in production -- see SECURITY.md, these
# endpoints are open to anyone if this is left unset.
CRAWLPAY_SITE_KEY=

# --- Exactly ONE of the next two config sources, not both ---
# A site is expected to be managed by the WordPress plugin's own config
# endpoint, OR the Phase 6 publisher dashboard, not both at once (see
# src/config/publisher-config-source.ts's docblock). If neither is set, the
# middleware falls back to the local config/publisher-config.json file.

# The WordPress site whose Settings > CrawlPay page owns policy/pricing.
# The middleware polls GET <this>/wp-json/crawlpay/v1/config every 30s.
CRAWLPAY_WORDPRESS_URL=

# The Phase 6 publisher dashboard to poll GET /api/v1/config from instead
# (see that site's Setup page for the URL + deploy key). Takes priority
# over CRAWLPAY_WORDPRESS_URL when both are set.
CRAWLPAY_DASHBOARD_URL=
CRAWLPAY_DASHBOARD_DEPLOY_KEY=
