# Copy to .env for local dev. Next.js loads .env automatically, and the
# Prisma CLI (db:migrate/db:studio/etc.) only reads .env, not .env.local --
# using plain .env here keeps both working from the one file.

# Same Postgres instance the middleware's CRAWLPAY_DATABASE_URL points at
# (see infra/docker-compose.yml for local dev) — the dashboard and
# middleware use different tables in it, see prisma/schema.prisma.
CRAWLPAY_DATABASE_URL=postgres://crawlpay:crawlpay@localhost:5432/crawlpay

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# SMTP server NextAuth's Email provider sends magic links through.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="CrawlPay <no-reply@example.com>"
