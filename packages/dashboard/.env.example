# Copy to .env (gitignored) and fill in real values.

# Postgres connection string from whatever provider you're using (Neon,
# Railway, a local Postgres, etc). For serverless targets like Vercel,
# prefer a pooled connection string if your provider offers one (e.g.
# Neon's "pooled connection" toggle) to avoid exhausting connections.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Resend (https://resend.com) sends the magic-link sign-in email. Sends
# from crawlpay.pro, which is verified with Resend -- see lib/auth-options.ts.
RESEND_API_KEY=

# Used to build absolute links (magic-link redirect target, setup-page
# instructions). Set to the deployed dashboard URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The middleware deployment the /dashboard/analytics page reads bot-traffic
# data from (GET <this>/api/v1/analytics/requests). The site key is the
# middleware's own CRAWLPAY_SITE_KEY -- the same shared secret that guards
# its /stats endpoint. One middleware per dashboard for now; per-site
# middleware URLs would need a column on Site. If unset, the analytics page
# renders in a degraded state with an explanatory note. See lib/analytics.ts.
CRAWLPAY_MIDDLEWARE_URL=http://localhost:8787
CRAWLPAY_MIDDLEWARE_SITE_KEY=
