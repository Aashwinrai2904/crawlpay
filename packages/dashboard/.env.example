# Copy to .env (gitignored) and fill in real values -- see the Supabase
# project's Settings > API and Settings > Database pages, or ask whoever
# provisioned the project (see ../../packages/dashboard's README).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Direct Postgres connection as the dedicated crawlpay_app role (not the
# Supabase-managed postgres superuser -- see prisma/schema.prisma's header
# comment for why). Uses port 5432 (direct) for local dev; swap to the
# connection pooler (port 6543, ?pgbouncer=true) before deploying to a
# serverless/edge target like Vercel.
DATABASE_URL=postgresql://crawlpay_app:your-password@db.your-project-ref.supabase.co:5432/postgres
